# Copy this file to .env and adjust values as needed.

APP_NAME=SynChain-ERP
APP_ENV=development
API_V1_PREFIX=/api/v1

# PostgreSQL — use host `db` when running via Docker Compose
DATABASE_URL=postgresql://synchain:synchain@localhost:5432/synchain_erp

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Service-to-service key for SynChain AI (header: X-API-Key)
API_KEY=synchain-erp-dev-api-key

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
